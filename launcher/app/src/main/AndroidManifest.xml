<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- GenTV HTTPS wallpaper, optional statistics and user-confirmed updates. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Needed since Android 10 to read the Wi-Fi network name for the network pill. Never requested at
         runtime: it is granted over ADB with pm grant, so lint's Android 12 "ask for COARSE with
         FINE" rule does not apply here. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        tools:ignore="CoarseFineLocation" />
    <!-- Puts the remote's accessibility helpers back after a force stop of this app took them off the enabled
         list (ServiceRepair). Granted over ADB with pm grant when a helper is enabled. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- YaOS (Yandex TV OS): HDMI, AV and the tuner all play in com.yandex.tv.live, whose activities require
         this permission (protection level normal, so it is granted at install). Ignored on other TVs. -->
    <uses-permission android:name="yandex.tv.permission.ACCESS_TV_SOURCE" />

    <!-- Android 11+ package visibility: lets the launcher list the TV apps it shows as tiles, and the
         apps that declare a module card (docs/reference/modules.md). -->
    <queries>
        <!-- The standard settings handlers, so package visibility doesn't hide them and send the pills to a vendor fallback by mistake. -->
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.HOME_SETTINGS" />
        </intent>
        <package android:name="com.huawei.android.internal.app" />
        <intent>
            <action android:name="android.settings.WIFI_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.DISPLAY_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.MANAGE_APPLICATIONS_SETTINGS" />
        </intent>
        <!-- The tile menu and the app library offer App info only where this resolves (SystemSettings.appInfo). -->
        <intent>
            <action android:name="android.settings.APPLICATION_DETAILS_SETTINGS" />
            <data android:scheme="package" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.gentv.tv.category.DOCK_CARD" />
        </intent>
        <!-- stock_home_redirect: HomeKeyService looks up the stock launcher's HOME activity. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- China-market MIUI TV firmware: the Settings and Wi-Fi pills fall back to Xiaomi's settings app.
             Fire TV: the real settings menu lives in the stock launcher (see settings_fallback_components). -->
        <package android:name="com.xiaomi.mitv.settings" />
        <package android:name="com.tcl.settings" />
        <package android:name="com.amazon.tv.launcher" />
        <!-- Coocaa OS sources for the Inputs menu (coocaa_sources); see CoocaaSources. -->
        <provider android:authorities="com.skyworth.tv.provider" />
        <provider android:authorities="com.skyworth.tv.sdk.provider" />
    </queries>

    <application
        android:name=".TvMetrics"
        android:appComponentFactory="com.gentv.tv.GameRuntimeComponentFactory"
        tools:replace="android:appComponentFactory"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:theme="@style/Theme.GenTV"
        android:allowBackup="false"
        android:localeConfig="@xml/locales_config">

        <activity android:name=".ChildChallengeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.childChallenge"
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen" />
        <activity android:name=".ChildSettingsActivity" android:exported="false" />
        <activity android:name=".MetricsSettingsActivity" android:exported="false" />
        <activity android:name=".CloudSettingsActivity" android:exported="false" android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen" />
        <activity android:name=".GameModuleActivity" android:exported="false"
            android:launchMode="singleTop" android:screenOrientation="landscape"
            android:theme="@style/Theme.GenTV" />
        <activity android:name=".GameRuntimeHostActivity" android:exported="false"
            android:process=":game_runtime" android:screenOrientation="landscape"
            android:theme="@style/Theme.GenTV" />
        <!-- Gecko subprocess implementations live in the uninstalled game plugin. -->
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$tab0" android:process=":tab0" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$tab1" android:process=":tab1" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$tab2" android:process=":tab2" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$tab3" android:process=":tab3" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$tab4" android:process=":tab4" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$tab5" android:process=":tab5" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$tab6" android:process=":tab6" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$tab7" android:process=":tab7" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$tab8" android:process=":tab8" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$tab9" android:process=":tab9" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$tab10" android:process=":tab10" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$tab11" android:process=":tab11" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$tab12" android:process=":tab12" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$tab13" android:process=":tab13" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$tab14" android:process=":tab14" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$tab15" android:process=":tab15" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$tab16" android:process=":tab16" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$tab17" android:process=":tab17" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$tab18" android:process=":tab18" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$tab19" android:process=":tab19" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$tab20" android:process=":tab20" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$tab21" android:process=":tab21" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$tab22" android:process=":tab22" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$tab23" android:process=":tab23" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$tab24" android:process=":tab24" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$tab25" android:process=":tab25" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$tab26" android:process=":tab26" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$tab27" android:process=":tab27" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$tab28" android:process=":tab28" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$tab29" android:process=":tab29" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$tab30" android:process=":tab30" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$tab31" android:process=":tab31" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$tab32" android:process=":tab32" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$tab33" android:process=":tab33" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$tab34" android:process=":tab34" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$tab35" android:process=":tab35" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$tab36" android:process=":tab36" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$tab37" android:process=":tab37" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$tab38" android:process=":tab38" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$tab39" android:process=":tab39" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.media.MediaManager" android:process=":media" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$gmplugin" android:process=":gmplugin" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$socket" android:process=":socket" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$gpu" android:process=":gpu" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$utility" android:process=":utility" android:exported="false" tools:ignore="MissingClass" />
        <service android:name="org.mozilla.gecko.process.GeckoChildProcessServices$ipdlunittest" android:process=":ipdlunittest" android:exported="false" tools:ignore="MissingClass" />
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.updates" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/update_paths" />
        </provider>
        <receiver android:name=".DesktopReceiver" android:exported="true" android:permission="android.permission.WRITE_SECURE_SETTINGS" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- Some TV firmware sends HOME together with COMMON_HOME or LAUNCHER.
                     Keep the categories in one filter to avoid duplicate launcher entries. -->
                <category android:name="android.intent.category.COMMON_HOME" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Coocaa's private home selection category. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME.CC" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LauncherSettingsActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape" />
        <activity android:name=".WeatherSettingsActivity" android:exported="false"
            android:excludeFromRecents="true" android:screenOrientation="landscape" />
        <activity android:name=".PersonalizationActivity" android:exported="false"
            android:excludeFromRecents="true" android:screenOrientation="landscape" />
        <activity android:name=".LocalWallpaperPickerActivity" android:exported="false"
            android:excludeFromRecents="true" android:screenOrientation="landscape" />
        <!-- The system input switcher (com.android.tv.action.VIEW_INPUTS), which is what the remote's Input
             button becomes through the TV's Live TV app or InputKeyService. Disabled here and switched on by
             MainActivity only while handle_view_inputs is true (config.xml or a theme), for sets whose stock
             launcher was the only handler of the action (Hisense huangshan, Android TV 10): kept off, a TV with
             its own input picker never sees a second candidate and a chooser. -->
        <activity
            android:name=".InputsRequestActivity"
            android:exported="true"
            android:enabled="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="com.android.tv.action.VIEW_INPUTS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Remote Settings button panel (settings_key_panel); own task so the app behind stays put.
             No screenOrientation: a translucent activity may not request one on Android 8.0 (API 26),
             which throws IllegalStateException in onCreate (#1122); a TV is landscape anyway. -->
        <activity
            android:name=".QuickSettingsActivity"
            android:exported="false"
            android:taskAffinity=""
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen" />
        <activity
            android:name=".XghSettingsRedirectActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen" />
        <activity
            android:name=".HomeSettingsActivity"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen" />
        <!-- Home button for remotes that send KEYCODE_ALL_APPS (Xiaomi). Opt-in, off by default;
             see HomeKeyService. -->
        <service
            android:name=".HomeKeyService"
            android:label="@string/home_key_name"
            android:directBootAware="true"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_key_service" />
        </service>

        <!-- market://launch?id=<package>: package-name app launches from the Android TV Remote service
             (Home Assistant android_tv_remote), normally served by the stock launcher. -->
        <activity
            android:name=".AppLaunchActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="market" android:host="launch" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AerialScreensaverActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.GenTV.Screensaver" />

        <!-- Clock fallback for the configured remote-key screensaver action. Home idle uses aerials. -->
        <activity
            android:name=".ClockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- stock_home_redirect at boot: HomeKeyService opens this invisible activity once, so the screen behind
             it sends a window event when it closes (HomeKeyService.probeAtBoot). -->
        <activity
            android:name=".ProbeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Screensaver: pick it in Settings, or `settings put secure screensaver_components
             com.gentv.tv/.ClockDream` over adb. -->
        <service
            android:name=".ClockDream"
            android:label="@string/dream_name"
            android:exported="true"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- GenTV Remote writes the theme through this where the shell can't reach Android/data;
             see ThemeProvider. WRITE_SECURE_SETTINGS: the adb shell has it, ordinary apps don't. -->
        <provider
            android:name=".ThemeProvider"
            android:authorities="${applicationId}.theme"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS" />

        <!-- The remote's Input button (KEYCODE_TV or KEYCODE_TV_INPUT) opens the input switcher, and input_key_keycodes and
         app_keys (config.xml or a theme) bring back other remote buttons; see InputKeyService. -->
        <!-- Bound again by the system after a force stop, which restarts Home on firmware that kills
             third-party apps (TCL tc8000_ay30a2). It reads no notification.
             cmd notification allow_listener com.gentv.tv/.GuardRevival -->
        <service
            android:name=".GuardRevival"
            android:directBootAware="true"
            android:exported="true"
            android:label="@string/home_key_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <receiver
            android:name=".GuardConfig"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS">
            <intent-filter>
                <action android:name="com.gentv.tv.GUARD" />
            </intent-filter>
        </receiver>

        <service android:name=".ChildWatchService" android:label="@string/child_lock_settings"
            android:exported="true" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/child_watch_service" />
        </service>
        <service
            android:name=".InputKeyService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/input_key_service" />
        </service>
    </application>
</manifest>
