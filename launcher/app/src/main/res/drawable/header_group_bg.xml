<?xml version="1.0" encoding="utf-8"?>
<!-- compact_header_icons: one capsule around all the top-right icons when the group has focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#30FFFFFF" />
            <stroke android:width="1dp" android:color="#88FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#24FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item><shape><solid android:color="#00000000" /></shape></item>
</selector>
