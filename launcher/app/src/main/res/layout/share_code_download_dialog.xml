<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="26dp"
    android:paddingTop="28dp"
    android:paddingEnd="26dp"
    android:paddingBottom="24dp">

    <ImageView
        android:id="@+id/share_download_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_share_placeholder_app" />

    <TextView
        android:id="@+id/share_download_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="#F5F7FA"
        android:textSize="17sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/share_download_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/share_code_download_starting"
            android:textColor="#BFFFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/share_download_percentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="#F5F7FA"
            android:textSize="14sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/share_download_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="9dp"
        android:importantForAccessibility="no"
        android:indeterminateOnly="false"
        android:max="100"
        android:maxHeight="6dp"
        android:minHeight="6dp"
        android:progressDrawable="@drawable/share_code_download_track" />

    <Button
        android:id="@+id/share_download_cancel"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/share_code_dialog_button"
        android:focusableInTouchMode="true"
        android:minWidth="96dp"
        android:paddingEnd="16dp"
        android:paddingStart="16dp"
        android:text="@android:string/cancel"
        android:textAllCaps="false"
        android:textSize="14sp" />

</LinearLayout>
