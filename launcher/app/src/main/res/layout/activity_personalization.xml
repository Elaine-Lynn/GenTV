<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07101D"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ImageView
        android:id="@+id/wallpaperPreviousPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/wallpaperPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <TextureView
        android:id="@+id/wallpaperVideoPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:focusable="false" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80030A18" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:focusable="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="64dp"
        android:paddingEnd="64dp"
        android:paddingTop="48dp"
        android:paddingBottom="20dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/quick_personalize"
            android:textColor="#FFFFFFFF"
            android:textSize="32sp"
            android:fontFamily="@string/font_medium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/wallpaper_personalization_hint"
            android:textColor="#CCFFFFFF"
            android:textSize="17sp" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wallpaper_personal_title"
            android:textColor="#EEFFFFFF"
            android:textSize="18sp"
            android:fontFamily="@string/font_medium" />

        <androidx.leanback.widget.HorizontalGridView
            android:id="@+id/wallpaperChoices"
            android:layout_width="match_parent"
            android:layout_height="151dp"
            android:nextFocusDown="@id/wallpaperUserChoices"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:overScrollMode="never" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/wallpaper_user_title"
            android:textColor="#EEFFFFFF"
            android:textSize="18sp"
            android:fontFamily="@string/font_medium" />

        <androidx.leanback.widget.HorizontalGridView
            android:id="@+id/wallpaperUserChoices"
            android:layout_width="match_parent"
            android:layout_height="151dp"
            android:nextFocusUp="@id/wallpaperChoices"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:overScrollMode="never" />
    </LinearLayout>
    </ScrollView>
</FrameLayout>
