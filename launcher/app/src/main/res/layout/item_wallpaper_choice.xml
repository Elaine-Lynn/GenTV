<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="200dp"
    android:layout_height="145dp"
    android:orientation="vertical"
    android:padding="7dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:clickable="true">

    <FrameLayout
        android:id="@+id/wallpaperCard"
        android:layout_width="186dp"
        android:layout_height="105dp"
        android:background="@drawable/tile_bg"
        android:foreground="@drawable/more_app_focus">
        <ImageView
            android:id="@+id/wallpaperImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/wallpaperAdd"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="+"
            android:textColor="#FFFFFFFF"
            android:textSize="56sp"
            android:visibility="gone" />
        <ImageView
            android:id="@+id/wallpaperPlay"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:padding="7dp"
            android:background="@drawable/wallpaper_badge_bg"
            android:src="@drawable/ic_wallpaper_play"
            android:contentDescription="@string/wallpaper_user_video"
            android:visibility="gone" />
        <TextView
            android:id="@+id/selectedBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="10dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/wallpaper_badge_bg"
            android:text="@string/wallpaper_selected"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/wallpaperName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:fontFamily="@string/font_medium"
        android:singleLine="true"
        android:ellipsize="end" />
</LinearLayout>
