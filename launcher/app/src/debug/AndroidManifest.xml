<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingLeanbackLauncher,ImpliedTouchscreenHardware,MissingLeanbackSupport">
    <!-- TV launcher intent and optional hardware features are declared in the main manifest. -->
    <application android:usesCleartextTraffic="true">
        <!-- Isolated, debug-only entry for the no-install GeckoView loading experiment. -->
        <activity android:name=".GameRuntimeProbeActivity" android:exported="true"
            android:process=":game_runtime_probe" android:screenOrientation="landscape" />
        <activity android:name=".GameRuntimeHostActivity" android:exported="true"
            tools:replace="android:exported" />
    </application>
</manifest>
