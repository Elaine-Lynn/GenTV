{
  "manifest_version": 2,
  "name": "GenTV game input bridge",
  "version": "1.0",
  "browser_specific_settings": {
    "gecko": { "id": "game-input@gentv.local" }
  },
  "content_scripts": [{
    "matches": ["https://kart.igame86.com/*"],
    "js": ["game_controls.js"],
    "run_at": "document_start"
  }],
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons"]
}
